# Database
DATABASE_URL=postgresql://evoforge:evoforge@localhost:5432/evoforge
POSTGRES_USER=evoforge
POSTGRES_PASSWORD=evoforge
POSTGRES_DB=evoforge

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Ray Configuration
RAY_ADDRESS=auto
RAY_NUM_CPUS=8
RAY_NUM_GPUS=0

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Evolution Settings
MAX_GENERATIONS=100
POPULATION_SIZE=50
MUTATION_RATE=0.3

# Sandbox Settings
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NETWORK_ENABLED=false

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
